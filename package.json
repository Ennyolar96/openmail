{
  "name": "open-mail",
  "main": "dist/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "tsc:init": "bunx tsc --init",
    "build": "bunx tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "watch": "bunx tsc --watch",
    "start": "node dist/main.js",
    "nodemon": "nodemon -r tsconfig-paths/register src/main.ts",
    "start:dev": "npm-run-all --parallel watch nodemon",
    "deploy": "netlify deploy --prod"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "npm-run-all": "^4.1.5",
    "ts-alias": "^0.0.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "class-validator-jsonschema": "^5.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "nodemailer": "^8.0.1",
    "p-limit": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0"
  }
}
